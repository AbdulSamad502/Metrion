# Local development environment variables for docker-compose.yml
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# PostgreSQL (pgvector-enabled)
POSTGRES_USER=metrion
POSTGRES_PASSWORD=metrion_dev_password
POSTGRES_DB=metrion
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# calc-engine database roles (auth.md §7.3 — see docker/postgres-init/02-roles.sql).
# DATABASE_URL (metrion_migrate, table owner) runs Alembic migrations.
# DATABASE_URL_APP (metrion_app, NOBYPASSRLS) is the only role the engine's own repositories
# and its RLS integration tests connect as — RLS is meaningless against the owning role.
DATABASE_URL=postgresql+psycopg://metrion_migrate:metrion_migrate_dev_password@localhost:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-metrion}
DATABASE_URL_APP=postgresql+psycopg://metrion_app:metrion_app_dev_password@localhost:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-metrion}
