# Local development environment for backend/. Copy to .env and fill in real values —
# never commit .env.

# Postgres roles — same values as the repo-root .env.example (docker-compose Postgres).
DATABASE_URL=postgresql+psycopg://metrion_migrate:metrion_migrate_dev_password@localhost:5432/metrion
DATABASE_URL_APP=postgresql+psycopg://metrion_app:metrion_app_dev_password@localhost:5432/metrion

# Clerk (auth.md). CLERK_SECRET_KEY is the same value as frontend/.env.local's
# CLERK_SECRET_KEY — copy it from there, never paste it in chat or a PR.
CLERK_SECRET_KEY=sk_test_xxx

# From Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret, once the endpoint
# is created (see backend/README.md).
CLERK_WEBHOOK_SECRET=whsec_xxx

# The instance's PEM public key, for networkless JWT verification (auth/context.py) —
# without it, every request does a live JWKS network fetch with no bounded timeout.
# Get it with: MSYS_NO_PATHCONV=1 clerk api /jwks   (then convert the JWK n/e to PEM,
# or use Dashboard -> API Keys -> Advanced -> JWT public key directly).
# \n-escaped on one line, unescaped by config.py.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nxxx\n-----END PUBLIC KEY-----
# Optional. Leeway (ms, 0-120000) between this machine's clock and Clerk's token timestamps.
# Unset = 5000 for a production Clerk instance (sk_live_), 30000 for a development one (sk_test_).
# If the backend log says "Clerk token timing rejected", fix the system clock first (Windows:
# w32tm /resync); raise this only for local development.
# CLERK_CLOCK_SKEW_MS=30000

# The ONE browser origin allowed by CORS: scheme + host (+ port), no path, no trailing slash, no wildcard. Local development defaults to http://localhost:3000.
# A DEPLOYMENT must set it explicitly (https, except a loopback host) or the backend refuses to start. A process counts as a deployment when METRION_ENV is
# production / prod / staging, or CLERK_SECRET_KEY is a live key (sk_live_...).
FRONTEND_ORIGIN=http://localhost:3000
# METRION_ENV=production

# --- Database connections (all seven engines: backend + six packages; each reads these) ---------------------------------------------------------
# DB_CONNECT_TIMEOUT_SECONDS  default 10   how long a new connection may take before the request fails (a stalled database no longer hangs requests)
# DB_POOL_SIZE                default 5    pooled connections per engine (SQLAlchemy's own default)
# DB_MAX_OVERFLOW             default 10   extra connections per engine under load (SQLAlchemy's own default)
# DB_POOL_TIMEOUT_SECONDS     default 30   how long a caller waits for a free pooled connection before failing (SQLAlchemy's own default)
# Positive integers only; anything else stops the process at first use. The pool numbers are NOT tuned for production: size them with a load test. Remember that each
# of the seven engines holds its own pool, and that every in-flight CEO turn and every RUNNING run holds a connection (turn lock / run ownership).

# --- Request size ----------------------------------------------------------------------------------------------------------------------------
# The largest body any NON-upload route accepts (default 1048576 = 1 MiB); larger is refused with 413 before it is parsed. 0 = no application limit (then a reverse proxy must
# enforce one). Upload routes keep their own limits (CFO_MAX_UPLOAD_BYTES, CI_MAX_EVIDENCE_BYTES, CMO image limit, CEO_ATTACHMENT_MAX_BYTES).
# API_MAX_BODY_BYTES=1048576

# --- Competitor Intelligence: local vision extraction (evidence/vision_extractor.py) -----
# Optional — each has a code-level default, but the defaults assume a model name that may
# not exist on your machine's Ollama install. Set these explicitly to whatever vision model
# you've actually pulled (`ollama pull <model>`, `ollama list` to check), or screenshot
# uploads will fail with an Ollama "model not found" error that gives no hint an env var is
# the cause.
OLLAMA_HOST=http://localhost:11434
CI_VISION_MODEL=qwen2.5vl-manual
# Vision request timeout / model residency (config.py: ollama_vision_timeout_seconds / ollama_keep_alive).
# Optional; defaults: 60 s timeout, Ollama's own keep_alive. A timed-out extraction degrades to manual
# entry (never a fabricated value). Measured 2026-10-02 on a CPU-only host (i5-12450H, 16 GB, llava 7B,
# idle machine, 12 calls): median 65 s; 10 of 12 between 38 and 117 s; 2 stalls of 488 s and 606 s under
# memory pressure. At the 60 s default, 6 of 12 calls timed out. On a CPU-only host, 180 covers the
# normal range while still failing the stalls instead of holding a worker for ~10 minutes:
# OLLAMA_VISION_TIMEOUT_SECONDS=180
# Model reload after Ollama unloads it (5 min idle by default) measured 13.5 s (file in OS cache) to
# ~140 s (cold disk). Keeping it loaded holds ~4.8 GB of RAM — only worth it with RAM to spare:
# OLLAMA_KEEP_ALIVE=30m
CI_REVIEW_VISION_MODEL=qwen2.5vl-manual

# Local-disk storage for seller-uploaded evidence screenshots. Optional — defaults to
# ./data/ci-evidence (relative to wherever uvicorn is started from). This directory is
# git-ignored; it holds real uploaded images, never commit its contents.
CI_EVIDENCE_DIR=./data/ci-evidence

# --- CFO: local Brain-3 narration (cfo/reasoning/narrate.py, ollama_provider.py) ----------
# Optional — defaults to "qwen3:8b", which may not exist on your machine's Ollama install.
# Set explicitly to whatever text model you've actually pulled (`ollama pull <model>`), or
# POST /api/v1/cfo/period-comparison will fail with an Ollama "model not found" error.
CFO_NARRATION_MODEL=qwen3:8b

# --- Product Intelligence: discovery/supplier sources (product-intelligence package) ------
# Required for real (non-fake) calls out of packages/product-intelligence's sources/ and
# supplier/ clients — Phase 1 is standalone and independently testable with fakes, so none of
# these are required to run PI's unit tests, only its Checkpoint 4 manual live-call pass (or,
# once Phase 2 wires HTTP routes, real requests through the backend).
# Tavily (packages/product-intelligence/src/product_intelligence/sources/tavily_client.py) —
# free tier, 1,000 credits/mo, no card: https://app.tavily.com
TAVILY_API_KEY=
# CI competitor discovery (competitor-intelligence-agent.md C34): which search provider CI composes. `tavily` (default, uses TAVILY_API_KEY above) or `mock`
# (fixtures only, finds nothing; for local work without a key). An unset key with `tavily` is an honest failed search, never a silent switch to the mock.
# CI_SEARCH_PROVIDER=tavily
# Most Tavily queries one tenant's CI discovery may send per rolling 24 hours (provisional; the real ceiling is a commercial decision).
# CI_TAVILY_DAILY_QUERY_CAP=100
# YouTube Data API v3 (sources/youtube_client.py) — free, 10,000 units/day quota, from a
# Google Cloud project: https://console.cloud.google.com (enable "YouTube Data API v3")
YOUTUBE_API_KEY=
# Google Places API (New) (supplier/google_places_client.py) — ID-only search is free/
# uncapped tier; Place Details enrichment (phone/website/address) is the paid Pro tier, only
# called for a seller's final top-5 candidates (pi_supplier_lookup.py's own cost-bounding
# split): https://console.cloud.google.com (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=
# Google Ads API Keyword Plan Idea Service (sources/keyword_demand_client.py) — dropped from
# this build at Checkpoint 0 (brand verification not ready). Intentionally no env var slot
# yet; add one when that client is wired up, not before.

# --- Product Intelligence: local text classification / embeddings (review_insight/, ---
# --- embedding/) — reuses OLLAMA_HOST above, no separate host var. -------------------------
# Optional — defaults assume model names that may not exist on your machine's Ollama install.
PI_TEXT_INSIGHT_MODEL=qwen3:8b
# discovery/product_extraction.py's product-name-mention extraction — a separate task from
# PI_TEXT_INSIGHT_MODEL above (different prompt/output contract), own configurable default.
PI_PRODUCT_EXTRACTION_MODEL=qwen3:8b
# nomic-embed-text's dimension (768) is hardcoded in embedding/embed.py and the
# product_embedding.embedding column type — do not repoint this at a different-dimension
# model without also updating both.
PI_EMBEDDING_MODEL=nomic-embed-text

# --- Upload size limits (config.py: cfo_max_upload_bytes / ci_max_evidence_bytes) ----------------
# Optional. Oversized uploads are rejected with HTTP 413 — by request_limits.py before the body is
# parsed or spooled, and again by the route for the exact file size. The ingestion pipeline holds a
# whole CSV in memory at ~31x its size (measured), so the 20 MB default bounds one concurrent
# ingestion at roughly 0.6 GB; raise it only with that budget in mind. Your reverse proxy must ALSO
# cap the request body — see README "Request-body limits".
# CFO_MAX_UPLOAD_BYTES=20971520
# CI_MAX_EVIDENCE_BYTES=10485760

# --- Slim CMO (api/v1/cmo.py, services/cmo_runtime.py) -- ALL REQUIRED, no defaults -------------
# Unset => the CMO routes answer 503 CMO_NOT_CONFIGURED before doing any work.
# Optional. Which LLM backend (default: ollama = development). A hosted model is added by registering a provider in services/cmo_runtime.py.
# CMO_LLM_PROVIDER=ollama
# CMO_LLM_MODEL=<model name for the chosen provider; for ollama, a model you have pulled>
# CMO_OLLAMA_HOST=http://localhost:11434
# CMO_LLM_TIMEOUT_SECONDS=120
# Optional. Set false for reasoning models (qwen3): otherwise each call spends ~70 s thinking. Unset = model default.
# CMO_LLM_THINK=false
# DEV ONLY: allow placeholder TEST_FIXTURE format constraints (never use in production). Default false = VERIFIED rows only.
# CMO_ACCEPT_TEST_FIXTURE_CONSTRAINTS=true
# How long an in-flight quota reservation counts against a CMO cap (only needed once a cap is seeded).
# CMO_QUOTA_RESERVATION_TTL_SECONDS=300
# PI quota reservation (approval prerequisite R6). Required once ANY PI / research.niche_run cap is seeded; no default. It must be at least the action's
# structural worst-case duration (pi.discover ~1850 s at the default candidate cap; see product_intelligence/timing.py) or the request is refused (503 PI_NOT_CONFIGURED).
# PI caps are NOT enforced and must not be seeded without this.
# PI_QUOTA_RESERVATION_TTL_SECONDS=

# --- Slim CMO image intake and analysis (P6) -- ALL REQUIRED, no defaults ------------------------
# Upload limits: unset => POST /api/v1/cmo/images answers 503 CMO_NOT_CONFIGURED. Uploads are re-encoded (EXIF/GPS and
# every other metadata block stripped) before storage and before the vision model sees them.
# CMO_IMAGE_DIR=./data/cmo-images
# Read-only CMO showcase (docs/specs/ceo-cmo-delegation.md 6.9-6.10, OQ-19). NO defaults: the owner sets these.
# Unset CMO_SHOWCASE_PAGE_LIMIT => the showcase list routes answer 503 CMO_NOT_CONFIGURED.
# Unset CMO_FREQUENT_MIN_COUNT or CMO_FREQUENT_LOOKBACK_DAYS => "Frequently used" is reported UNAVAILABLE (never guessed).
# Unset CMO_USAGE_EVENT_DEDUP_SECONDS => only an exact repeat within one second is collapsed.
# CMO_SHOWCASE_PAGE_LIMIT=
# CMO_FREQUENT_MIN_COUNT=
# CMO_FREQUENT_LOOKBACK_DAYS=
# CMO_USAGE_EVENT_DEDUP_SECONDS=
# CMO_IMAGE_MAX_BYTES=5242880
# CMO_IMAGE_MAX_PIXELS=25000000
# CMO_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
# Photo analysis (local Ollama only). Unset => POST /api/v1/cmo/image-analyses answers 503 CMO_NOT_CONFIGURED.
# CMO_VISION_MODEL=<a vision model you have pulled>
# CMO_VISION_OLLAMA_HOST=http://localhost:11434
# CMO_VISION_TIMEOUT_SECONDS=180
# Per-tenant limit on model calls (analysis is 0 units, so this is the guard): at most N analyses per window.
# CMO_VISION_ANALYSES_PER_WINDOW=10
# CMO_VISION_RATE_WINDOW_SECONDS=3600


# --- CEO (B3) -------------------------------------------------------------------------------------------------------
# REQUIRED to use the CEO routes (503 CEO_NOT_CONFIGURED otherwise). No default model is chosen anywhere in code.
# CEO_LLM_MODEL=
# CEO_LLM_TIMEOUT_SECONDS=
# OPTIONAL: a separate (smaller) model for the single classification pass; local server address; provider; thinking switch.
# CEO_CLASSIFIER_MODEL=
# CEO_OLLAMA_HOST=
# CEO_LLM_PROVIDER=ollama
# CEO_LLM_THINK=false
# Leg bounds have NO default (spec 6.12 rule 5): unset => an investigation with specialist legs refuses with CONFIG_MISSING.
# CEO_LEG_TIMEOUT_SECONDS=
# How long an APPROVED product-research plan waits for the research run before saying "still running". A real run took ~10 minutes with local models (2026-10-14), so set this well
# above CEO_LEG_TIMEOUT_SECONDS (for example 1200). Unset => the ordinary leg deadline applies and cuts a real run off. No default.
# CEO_PI_RESEARCH_TIMEOUT_SECONDS=
# OPTIONAL hard leg deadline (ceo/deadlines.py). NO default; unset => a leg that outlives its turn is never settled by age. Set it LONGER than CEO_LEG_TIMEOUT_SECONDS: a leg still open
# this long after it started is recorded as timed out (never re-run; outside-effect actions are marked 'may still be running or may already have taken effect').
# CEO_LEG_ABANDON_SECONDS=
# CEO_PLAYBOOK_MAX_LEGS=
# Approval workflow (ceo-approval-workflow.md). Default false = a chat request for a metered / data-sending action is REFUSED (nothing runs). true = chat produces an exact plan with
# Approve / Decline on its card; only the explicit approve API call (bound to the plan id and hash) ever runs it. The plan 30-minute lifetime is a code constant, not a setting.
# Set true only after the owner accepts the crash-recovery and billing verification gates (ceo-cmo-delegation.md OQ-9). Needs CEO_LEG_TIMEOUT_SECONDS and CEO_PLAYBOOK_MAX_LEGS.
# CEO_APPROVAL_ENABLED=false
# CEO -> CMO delegation (ceo-cmo-delegation.md CD13). The seller asks the CEO for titles, descriptions, keywords, hashtags or market news; the CEO asks what is missing, then shows an exact plan card.
# These bound that question loop and are read on the server only. UNSET => the default shown. Present but not a positive whole number => the CEO declines to start a CMO task (CONFIG_INVALID).
# Chat plan cards for these CMO actions do not need CEO_APPROVAL_ENABLED; other agents' approval-required actions still follow it.
# CMO_DELEGATION_MAX_QUESTIONS=8        (questions per task, re-asks included; a 9th is never asked)
# CMO_DELEGATION_MAX_REASKS=2           (a field is asked at most 1 + this many times)
# CMO_DELEGATION_IDLE_EXPIRY_SECONDS=86400   (24 h of inactivity; the answers are kept but a fresh confirmation is required)
# The most candidate prices one price-impact run may carry (spec 6.33, Q32). NO default; unset => that playbook refuses with CONFIG_MISSING. 5 is a suggestion only.
# CEO_MAX_CANDIDATE_PRICES=
# Chat attachments (spec 6.34) have NO defaults: unset => the chat bar refuses files (503 ATTACHMENTS_NOT_CONFIGURED) and says which three settings to set. Restart the backend after setting them.
# Supported (decided from the CONTENT, never the name): PNG, JPEG, WEBP, PDF, CSV, XLSX. Stored per conversation and per tenant in the database (no file storage service is needed).
# PDF/CSV/XLSX are read as bounded, untrusted text for the CEO to quote; images are stored but not read. Attached spreadsheets are NOT financial imports: use Profit & Finance for that.
# Suggested for development: 10485760 (10 MB per file), 5 files per message, 20 PDF pages.
# CEO_ATTACHMENT_MAX_BYTES=
# CEO_ATTACHMENT_MAX_FILES=
# CEO_ATTACHMENT_MAX_PAGES=

# LLM endpoint attestation (approval prerequisite R7). No default. Comma-separated EXACT host:port entries you control, e.g. a local Ollama:
#   LLM_OPERATOR_CONTROLLED_HOSTS=localhost:11434
# Every model endpoint above (OLLAMA_HOST, CEO_OLLAMA_HOST, CMO_OLLAMA_HOST, CMO_VISION_OLLAMA_HOST) must appear here, otherwise it is treated
# as EXTERNAL and model calls are refused (loopback alone is not evidence of control; no data-disclosure policy exists for third-party endpoints).
# LLM_OPERATOR_CONTROLLED_HOSTS=

# Interactive API docs + OpenAPI document (/docs, /redoc, /openapi.json). Unauthenticated and they list every route: leave unset in any shared or production deployment.
# API_DOCS_ENABLED=true

# How often (seconds) a running backend looks for runs whose worker died (default 300; 0 = start-up recovery only). A polling interval, not a deadline: a live run is never touched.
# RECOVERY_SWEEP_INTERVAL_SECONDS=300

# Operations endpoints (/api/v1/ops/live, /ready, /runs): liveness, database readiness and recovery diagnostics (counts only, no tenant data). OFF unless this is set; at least 24
# characters, sent by the probe as the X-Ops-Token header. Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))". Never commit it.
# OPS_TOKEN=

# --- RAG (docs/specs/rag-knowledge.md) -------------------------------------------------------------
# All optional. The embedding model is provisional until the P-1 benchmark report is approved (nomic-embed-text vs bge-m3).
# Self-hosted only: RAG_OLLAMA_HOST defaults to OLLAMA_HOST.
# RAG_EMBEDDING_MODEL=nomic-embed-text
# RAG_OLLAMA_HOST=http://localhost:11434
# RAG_EMBED_TIMEOUT_SECONDS=3
# RAG_MAX_DOCUMENT_BYTES=10485760
# RAG_MAX_DOCUMENTS_PER_TENANT=50
# Competitor Intelligence housekeeping over its own stored data (CI spec 6.25): expire unanswered confirmation questions, release quiet-hours alerts, add freshness reminders. Default 900; 0 = off. Makes no outbound request.
# CI_SCHEDULER_INTERVAL_SECONDS=900
# Most competitors a tenant may track when the tenant has no limit of its own (ci_tenant_config.max_active_competitors, set by an operator). Unset = no limit.
# CI_DEFAULT_WATCHLIST_LIMIT=
