# Local development environment for backend/. Copy to .env and fill in real values —
# never commit .env.

# Postgres roles — same values as the repo-root .env.example (docker-compose Postgres).
DATABASE_URL=postgresql+psycopg://metrion_migrate:metrion_migrate_dev_password@localhost:5432/metrion
DATABASE_URL_APP=postgresql+psycopg://metrion_app:metrion_app_dev_password@localhost:5432/metrion

# Clerk (auth.md). CLERK_SECRET_KEY is the same value as frontend/.env.local's
# CLERK_SECRET_KEY — copy it from there, never paste it in chat or a PR.
CLERK_SECRET_KEY=sk_test_xxx

# From Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret, once the endpoint
# is created (see backend/README.md).
CLERK_WEBHOOK_SECRET=whsec_xxx

# The instance's PEM public key, for networkless JWT verification (auth/context.py) —
# without it, every request does a live JWKS network fetch with no bounded timeout.
# Get it with: MSYS_NO_PATHCONV=1 clerk api /jwks   (then convert the JWK n/e to PEM,
# or use Dashboard -> API Keys -> Advanced -> JWT public key directly).
# \n-escaped on one line, unescaped by config.py.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nxxx\n-----END PUBLIC KEY-----

# The Next.js dev server's origin, for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# --- Competitor Intelligence: local vision extraction (evidence/vision_extractor.py) -----
# Optional — each has a code-level default, but the defaults assume a model name that may
# not exist on your machine's Ollama install. Set these explicitly to whatever vision model
# you've actually pulled (`ollama pull <model>`, `ollama list` to check), or screenshot
# uploads will fail with an Ollama "model not found" error that gives no hint an env var is
# the cause.
OLLAMA_HOST=http://localhost:11434
CI_VISION_MODEL=qwen2.5vl-manual
CI_REVIEW_VISION_MODEL=qwen2.5vl-manual

# Local-disk storage for seller-uploaded evidence screenshots. Optional — defaults to
# ./data/ci-evidence (relative to wherever uvicorn is started from). This directory is
# git-ignored; it holds real uploaded images, never commit its contents.
CI_EVIDENCE_DIR=./data/ci-evidence

# --- CFO: local Brain-3 narration (cfo/reasoning/narrate.py, ollama_provider.py) ----------
# Optional — defaults to "qwen3:8b", which may not exist on your machine's Ollama install.
# Set explicitly to whatever text model you've actually pulled (`ollama pull <model>`), or
# POST /api/v1/cfo/period-comparison will fail with an Ollama "model not found" error.
CFO_NARRATION_MODEL=qwen3:8b

# --- Product Intelligence: discovery/supplier sources (product-intelligence package) ------
# Required for real (non-fake) calls out of packages/product-intelligence's sources/ and
# supplier/ clients — Phase 1 is standalone and independently testable with fakes, so none of
# these are required to run PI's unit tests, only its Checkpoint 4 manual live-call pass (or,
# once Phase 2 wires HTTP routes, real requests through the backend).
# Tavily (packages/product-intelligence/src/product_intelligence/sources/tavily_client.py) —
# free tier, 1,000 credits/mo, no card: https://app.tavily.com
TAVILY_API_KEY=
# YouTube Data API v3 (sources/youtube_client.py) — free, 10,000 units/day quota, from a
# Google Cloud project: https://console.cloud.google.com (enable "YouTube Data API v3")
YOUTUBE_API_KEY=
# Google Places API (New) (supplier/google_places_client.py) — ID-only search is free/
# uncapped tier; Place Details enrichment (phone/website/address) is the paid Pro tier, only
# called for a seller's final top-5 candidates (pi_supplier_lookup.py's own cost-bounding
# split): https://console.cloud.google.com (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=
# Google Ads API Keyword Plan Idea Service (sources/keyword_demand_client.py) — dropped from
# this build at Checkpoint 0 (brand verification not ready). Intentionally no env var slot
# yet; add one when that client is wired up, not before.

# --- Product Intelligence: local text classification / embeddings (review_insight/, ---
# --- embedding/) — reuses OLLAMA_HOST above, no separate host var. -------------------------
# Optional — defaults assume model names that may not exist on your machine's Ollama install.
PI_TEXT_INSIGHT_MODEL=qwen3:8b
# discovery/product_extraction.py's product-name-mention extraction — a separate task from
# PI_TEXT_INSIGHT_MODEL above (different prompt/output contract), own configurable default.
PI_PRODUCT_EXTRACTION_MODEL=qwen3:8b
# nomic-embed-text's dimension (768) is hardcoded in embedding/embed.py and the
# product_embedding.embedding column type — do not repoint this at a different-dimension
# model without also updating both.
PI_EMBEDDING_MODEL=nomic-embed-text
