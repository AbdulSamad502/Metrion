# Local development environment for frontend/. Copy to .env.local and fill in real values —
# never commit .env.local.
#
#   cp .env.local.example .env.local

# Clerk (auth.md). NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY come from the same
# Clerk instance/application — Dashboard -> API Keys. CLERK_SECRET_KEY is the same value
# backend/.env's CLERK_SECRET_KEY needs — copy it there too, never paste it in chat or a PR.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk's own sign-in/sign-up page routes and post-auth redirects — these match the custom
# auth UI's routes in this app, not Clerk's hosted defaults.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Where the backend (backend/) is running. Must match backend/.env's FRONTEND_ORIGIN's
# counterpart — this frontend's own origin (http://localhost:3000 by default) is what you
# put in backend/.env's FRONTEND_ORIGIN, and this is the reverse: where the frontend finds
# the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
