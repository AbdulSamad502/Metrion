.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
*.egg-info/
.venv/

# Local runtime data (uploaded evidence screenshots, uploaded CFO reports, etc.) — never committed.
# The backend writes to ./data/... relative to its working directory, so cover both locations.
backend/data/
/data/
.venv-ci/

# Downloaded design-tool binaries (reinstallable, not source)
.agents/skills/*/scripts/bin/
.claude/skills/*/scripts/bin/
.github/skills/*/scripts/bin/
.claude/settings.local.json
